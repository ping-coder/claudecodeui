#!/usr/bin/env bash
set -euo pipefail

export PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

BASE_DIR="${HOME}/apps/cloudcli"
REPO_DIR="${BASE_DIR}/repo"
RELEASES_DIR="${BASE_DIR}/releases"
SHARED_DIR="${BASE_DIR}/shared"
CURRENT_LINK="${BASE_DIR}/current"
PREV_FILE="${SHARED_DIR}/previous_release"
LOCK_HASH_FILE="${SHARED_DIR}/package_lock.sha256"
REPO_URL="https://github.com/ping-coder/claudecodeui.git"
UPSTREAM_URL="https://github.com/siteboon/claudecodeui.git"
HEALTH_URL="http://127.0.0.1:3001/health"
KEEP_RELEASES=8
DB_BACKUP_DIR="${SHARED_DIR}/db-backups"
KEEP_DB_BACKUPS=8
DEFAULT_DATABASE_PATH="${HOME}/.cloudcli/auth.db"

log() {
  printf "\033[1;34m[cloudcli-ctl %s]\033[0m %s\n" "$(date '+%H:%M:%S')" "$*"
}

err() {
  printf "\033[1;31m[cloudcli-ctl ERROR]\033[0m %s\n" "$*" >&2
}

wait_for_health() {
  local retries=15
  local i=1
  while [ "$i" -le "$retries" ]; do
    if resp=$(curl -fsS --max-time 2 "$HEALTH_URL" 2>/dev/null); then
      if echo "$resp" | grep -q '"status":"ok"'; then
        log "Health check passed: $resp"
        return 0
      fi
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

# The database the service uses: the first DATABASE_PATH= line of shared/.env
# (the unit's EnvironmentFile), else the server's default location.
resolve_database_path() {
  local db_path=""
  if [ -f "${SHARED_DIR}/.env" ]; then
    db_path=$(grep -m1 '^DATABASE_PATH=' "${SHARED_DIR}/.env" | cut -d= -f2- || true)
    db_path="${db_path%$'\r'}"
    db_path="${db_path#"${db_path%%[![:space:]]*}"}"
    db_path="${db_path%"${db_path##*[![:space:]]}"}"
    # systemd strips one pair of surrounding quotes from EnvironmentFile values.
    case "$db_path" in
      \"*\" | \'*\') db_path="${db_path:1:${#db_path}-2}" ;;
    esac
  fi
  printf '%s\n' "${db_path:-$DEFAULT_DATABASE_PATH}"
}

# Online backup of the live database into ${DB_BACKUP_DIR}/auth-<release_id>.db,
# keeping the newest KEEP_DB_BACKUPS. Returns non-zero on any failure so the
# deploy stops before the new release (and its migrations) starts. Backups hold
# password hashes and tokens, hence the 0700 directory and 0600 files.
backup_database() {
  local release_id="$1"
  local db_path backup_file tmp_file backup_js
  db_path=$(resolve_database_path)
  # The service resolves a relative path against its own working directory,
  # so checking it from here could silently skip the backup.
  if [ "${db_path#/}" = "$db_path" ]; then
    err "DATABASE_PATH '${db_path}' in ${SHARED_DIR}/.env is not an absolute path."
    return 1
  fi
  if [ ! -f "$db_path" ]; then
    log "No database at ${db_path}; skipping the pre-deploy backup."
    return 0
  fi

  backup_file="${DB_BACKUP_DIR}/auth-${release_id}.db"
  tmp_file="${backup_file}.tmp"
  log "Backing up ${db_path} -> ${backup_file}..."
  (umask 077 && mkdir -p "$DB_BACKUP_DIR") || return 1
  chmod 700 "$DB_BACKUP_DIR" || return 1
  rm -f "$tmp_file" "${tmp_file}-journal"

  # SQLite's backup API, not cp: the service may be writing while we copy.
  # Arguments: <better-sqlite3 module dir> <source db> <backup file>.
  backup_js=$(cat <<'JS'
const [modulePath, sourcePath, targetPath] = process.argv.slice(1);
const Database = require(modulePath);
(async () => {
  // Read-only, so a deploy can never write to the live database; the busy
  // timeout waits out a write the running service is committing.
  const source = new Database(sourcePath, { readonly: true, fileMustExist: true, timeout: 10000 });
  try {
    // One step copies every page under a single read lock, instead of 100-page
    // steps that restart from scratch whenever the service writes in between.
    await source.backup(targetPath, { progress: () => 0x7fffffff });
  } finally {
    source.close();
  }
  const copy = new Database(targetPath, { readonly: true, fileMustExist: true });
  try {
    const result = copy.pragma('integrity_check', { simple: true });
    if (result !== 'ok') throw new Error(`integrity_check on the backup returned: ${result}`);
  } finally {
    copy.close();
  }
})().catch((error) => {
  console.error(`Database backup failed: ${error && error.message ? error.message : error}`);
  process.exit(1);
});
JS
)
  if ! (umask 077 && node -e "$backup_js" "${REPO_DIR}/node_modules/better-sqlite3" "$db_path" "$tmp_file"); then
    rm -f "$tmp_file" "${tmp_file}-journal"
    return 1
  fi
  { chmod 600 "$tmp_file" && mv -f "$tmp_file" "$backup_file"; } || return 1
  log "Database backup passed integrity_check: ${backup_file}"

  ls -1t "$DB_BACKUP_DIR"/auth-*.db 2>/dev/null | tail -n +$((KEEP_DB_BACKUPS + 1)) | xargs -r rm -f -- \
    || err "Could not prune old database backups in ${DB_BACKUP_DIR}."
}

cmd_deploy() {
  local target_ref="${1:-origin/main}"
  mkdir -p "$RELEASES_DIR" "$SHARED_DIR"

  if [ ! -d "${REPO_DIR}/.git" ]; then
    log "Cloning ${REPO_URL} into ${REPO_DIR}..."
    gh auth setup-git >/dev/null 2>&1 || true
    git clone "$REPO_URL" "$REPO_DIR"
    cd "$REPO_DIR"
    git remote add upstream "$UPSTREAM_URL" 2>/dev/null || true
    git remote set-url --push upstream DISABLE
  fi

  cd "$REPO_DIR"
  log "Fetching latest commits from origin..."
  git fetch origin --prune --tags

  # Resolve target_ref to full commit SHA. A branch name means origin/<branch>
  # first: fetch never moves the local branch of the same name, so a stale
  # local main would otherwise deploy an old commit.
  if git rev-parse --verify --quiet "refs/remotes/origin/${target_ref}^{commit}" >/dev/null 2>&1; then
    target_ref="refs/remotes/origin/${target_ref}"
  elif ! git rev-parse --verify --quiet "${target_ref}^{commit}" >/dev/null 2>&1; then
    err "Cannot resolve git ref: ${target_ref}"
    exit 1
  fi

  local commit_sha commit_short commit_msg
  commit_sha=$(git rev-parse "${target_ref}^{commit}")
  commit_short=$(git rev-parse --short=7 "$commit_sha")
  commit_msg=$(git log -1 --pretty=%s "$commit_sha")

  log "Checking out ${commit_short} (${commit_msg})..."
  git checkout --force "$commit_sha"

  # Check if npm dependencies need installation
  local current_lock_hash
  current_lock_hash=$(sha256sum package-lock.json | awk '{print $1}')
  local saved_lock_hash=""
  if [ -f "$LOCK_HASH_FILE" ]; then
    saved_lock_hash=$(cat "$LOCK_HASH_FILE")
  fi

  if [ ! -d "node_modules" ] || [ "$current_lock_hash" != "$saved_lock_hash" ]; then
    log "Installing/updating npm dependencies (Node $(node -v))..."
    HUSKY=0 npm ci --include=dev
    echo "$current_lock_hash" > "$LOCK_HASH_FILE"
  else
    log "package-lock.json unchanged, reusing cached node_modules."
  fi

  log "Building client (Vite) and server (TypeScript)..."
  npm run build

  local ts release_id release_path
  ts=$(date '+%Y%m%d-%H%M%S')
  release_id="${ts}-${commit_short}"
  release_path="${RELEASES_DIR}/${release_id}"

  log "Creating immutable release snapshot: ${release_id}..."
  mkdir -p "$release_path"
  cp -a dist dist-server public shared server scripts package.json "$release_path/"
  ln -sfn "${REPO_DIR}/node_modules" "${release_path}/node_modules"
  ln -sfn "${SHARED_DIR}/.env" "${release_path}/.env"

  cat > "${release_path}/RELEASE_INFO" <<EOF
RELEASE_ID=${release_id}
COMMIT_SHA=${commit_sha}
COMMIT_SHORT=${commit_short}
COMMIT_MSG=${commit_msg}
DEPLOYED_AT=$(date -Is)
EOF

  # Before 'current' switches: the new release migrates the database when it
  # starts, and neither the automatic nor a manual rollback restores data.
  if ! backup_database "$release_id"; then
    err "Database backup failed; aborting before switching releases (the running service is untouched)."
    rm -rf "$release_path"
    exit 1
  fi

  local old_target=""
  if [ -L "$CURRENT_LINK" ] && [ -e "$CURRENT_LINK" ]; then
    old_target=$(readlink -f "$CURRENT_LINK")
    echo "$old_target" > "$PREV_FILE"
  fi

  log "Atomically switching 'current' -> ${release_id} and restarting cloudcli.service..."
  ln -sfn "$release_path" "$CURRENT_LINK"
  systemctl --user enable cloudcli.service >/dev/null 2>&1 || true
  systemctl --user restart cloudcli.service

  if wait_for_health; then
    log "✅ Deployment of ${release_id} (${commit_short}) succeeded!"
  else
    err "❌ Health check failed for ${release_id}!"
    if [ -n "$old_target" ] && [ -d "$old_target" ]; then
      err "Auto-rolling back to previous release: $(basename "$old_target")..."
      ln -sfn "$old_target" "$CURRENT_LINK"
      systemctl --user restart cloudcli.service
      wait_for_health || true
    fi
    exit 1
  fi

  # Prune old releases keeping the newest KEEP_RELEASES
  cd "$RELEASES_DIR"
  ls -1dt 20* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | xargs -r rm -rf --
}

cmd_rollback() {
  local target="${1:-}"
  local current_target=""
  if [ -L "$CURRENT_LINK" ] && [ -e "$CURRENT_LINK" ]; then
    current_target=$(readlink -f "$CURRENT_LINK")
  fi

  local rollback_path=""
  if [ -z "$target" ] || [ "$target" = "prev" ] || [ "$target" = "previous" ]; then
    if [ -f "$PREV_FILE" ]; then
      local cand
      cand=$(cat "$PREV_FILE")
      if [ -d "$cand" ] && [ "$cand" != "$current_target" ]; then
        rollback_path="$cand"
      fi
    fi
    if [ -z "$rollback_path" ]; then
      # Find the second newest release in RELEASES_DIR
      rollback_path=$(ls -1dt "${RELEASES_DIR}"/20* 2>/dev/null | grep -v "^${current_target}$" | head -n 1 || true)
    fi
  else
    # Match by exact release folder name or short SHA suffix
    if [ -d "${RELEASES_DIR}/${target}" ]; then
      rollback_path="${RELEASES_DIR}/${target}"
    else
      rollback_path=$(ls -1dt "${RELEASES_DIR}"/*"${target}"* 2>/dev/null | head -n 1 || true)
    fi
  fi

  if [ -z "$rollback_path" ] || [ ! -d "$rollback_path" ]; then
    err "No matching fallback release found in ${RELEASES_DIR}."
    cmd_list
    exit 1
  fi

  if [ "$rollback_path" = "$current_target" ]; then
    log "Already running release $(basename "$rollback_path")."
    exit 0
  fi

  if [ -n "$current_target" ]; then
    echo "$current_target" > "$PREV_FILE"
  fi

  log "Rolling back 'current' -> $(basename "$rollback_path")..."
  ln -sfn "$rollback_path" "$CURRENT_LINK"
  systemctl --user restart cloudcli.service

  if wait_for_health; then
    log "✅ Rollback to $(basename "$rollback_path") completed in <1s!"
  else
    err "❌ Health check failed after rollback to $(basename "$rollback_path")!"
    exit 1
  fi
}

cmd_list() {
  local current_target="" prev_target=""
  [ -L "$CURRENT_LINK" ] && current_target=$(readlink -f "$CURRENT_LINK" || true)
  [ -f "$PREV_FILE" ] && prev_target=$(cat "$PREV_FILE" || true)

  echo "Available Releases on $(hostname -s) (newest first):"
  echo "--------------------------------------------------------------------------------"
  for dir in $(ls -1dt "${RELEASES_DIR}"/20* 2>/dev/null || true); do
    local name marker="" msg=""
    name=$(basename "$dir")
    [ "$dir" = "$current_target" ] && marker=" [CURRENT]"
    [ "$dir" = "$prev_target" ] && [ "$dir" != "$current_target" ] && marker=" [PREVIOUS]"
    if [ -f "${dir}/RELEASE_INFO" ]; then
      msg=$(grep '^COMMIT_MSG=' "${dir}/RELEASE_INFO" | cut -d= -f2-)
    fi
    printf "  %-28s %-12s %s\n" "$name" "$marker" "$msg"
  done
  echo "--------------------------------------------------------------------------------"
}

cmd_status() {
  cmd_list
  echo ""
  echo "Health Endpoint (${HEALTH_URL}):"
  curl -fsS --max-time 2 "$HEALTH_URL" 2>/dev/null || echo "UNREACHABLE"
  echo -e "\n"
  systemctl --user status cloudcli.service --no-pager -n 15
}

case "${1:-status}" in
  deploy)   shift; cmd_deploy "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  list)     cmd_list ;;
  status)   cmd_status ;;
  *)
    echo "Usage: cloudcli-ctl {deploy [ref]|rollback [release_or_sha]|list|status}"
    exit 1
    ;;
esac

