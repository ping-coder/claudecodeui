# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# How long a Claude session's CLI keeps running after a turn while background
# work it started (agents, workflows, background commands, Monitor) is still
# going, in milliseconds. Restart the server after changing them.
#
# Let go after this long with nothing from the CLI, unless the session's own
# tasks are still running: a background command is silent until it ends.
# At least 60000. Default: 1800000 (30 minutes).
# CLOUDCLI_CLAUDE_HOLD_IDLE_MS=1800000
#
# Limit for work that never reports back: after this long without the model
# reporting on it, the remaining tasks are stopped and the CLI is let go. Not
# lower than the idle value. Default: 43200000 (12 hours).
# CLOUDCLI_CLAUDE_HOLD_MAX_MS=43200000

# Full path to the Antigravity CLI (agy). Without it, agy is looked up on PATH,
# then in ~/.local/bin. A path that does not exist means agy is not installed.
# Use absolute paths here and below: "~" is not expanded.
# AGY_CLI_PATH=/home/you/.local/bin/agy

# Colon-separated agy data folders to read conversations from (read-only).
# Default: ~/.gemini/antigravity-cli and ~/.gemini/antigravity
# AGY_DATA_DIRS=/home/you/.gemini/antigravity-cli:/home/you/.gemini/antigravity

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================

# Name of this deployment. A non-production name puts a marker at the start of
# the browser tab title, turns the tab icon amber, and shows an amber badge next
# to the app name in the sidebar (the header on phones) and on the login screen.
# staging, stage, preprod and pre-production show as "Stage" (Chinese: "预发布"),
# development and dev as "Dev" ("开发"), test and testing as "Test" ("测试");
# the tab title uses any other name exactly as written. The badges show the
# label in capitals and may shorten a long one; their tooltip has it in full.
# Unset, empty, "production" or "prod" (any case) means production: no marker.
# The public /health endpoint reports it as "environment" (null in production).
# Restart the server after changing it.
# CLOUDCLI_DEPLOY_ENV=staging

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session). Fallback only:
# a Claude session uses the window the SDK reports for its model once a turn completes.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


